{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:headless": "node scripts/build-headless.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-headless.mjs && node scripts/build-app.mjs",
    "start": "node dist-app/run.mjs",
    "bench": "node dist-app/bench.mjs",
    "soak": "node dist-app/soak.mjs",
    "package:release": "node scripts/package-release.mjs",
    "pretest": "npm run build:headless && npm run build:app",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "0.187.0",
    "electron": "^45.4.1",
    "esbuild": "0.28.2",
    "ffmpeg-static": "^5.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
